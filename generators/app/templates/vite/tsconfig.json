{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "checkJs": false,
    "declarationMap": false,
    "skipLibCheck": true,
    "target": "ESNext",
    "allowJs": false,
    "jsx": "preserve",
    "declaration": true,
    "types": ["vite/client"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "vite.config.js"]
}
